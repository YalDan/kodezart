+def _toml_is_header(line):
+    return bool(_HDR.match(line)) and not line.strip().startswith("#")
+
+
+def _toml_key_floor(m):
+    """First line at which a table header may be inserted into `m`.
+
+    TOML puts every headerless top-level key ABOVE the first table header: a
+    header inserted above one of them would swallow it into that table.
+    """
+    floor = 1
+    for k, v in m["sym"].items():
+        if "." in k or k.startswith("table:"):
+            continue
+        body = [l for l in v["text"].splitlines() if l.strip() and not l.strip().startswith("#")]
+        if not body or _toml_is_header(body[0]):
+            continue
+        floor = max(floor, v["end"] + 1)
+    return floor
+
+
+def _toml_bare_key(m, k):
+    """True when `k` is a headerless top-level key of `m` (never a table header)."""
+    v = m["sym"].get(k)
+    if v is None or "." in k or k.startswith("table:"):
+        return False
+    body = [l for l in v["text"].splitlines() if l.strip() and not l.strip().startswith("#")]
+    return bool(body) and not _toml_is_header(body[0])
+
+
+def _toml_displaced(cur, don, take):
+    """Headerless top-level keys of `cur` that a donor TABLE of the same name evicts.
+
+    TOML cannot hold both `x = "..."` and `[x]`, so the milestone that brings the
+    table takes the old scalar with it, whatever milestone the map records the
+    removal at (that later removal then finds nothing and is a no-op).
+    """
+    out = set()
+    for k in take:
+        dv = don["sym"].get(k)
+        if dv is None:
+            continue
+        body = [l for l in dv["text"].splitlines() if l.strip() and not l.strip().startswith("#")]
+        if not body or not _toml_is_header(body[0]):
+            continue
+        name = k[len("table:"):] if k.startswith("table:") else k
+        root = name.split(".")[0]
+        if _toml_bare_key(cur, root):
+            out.add(root)
+    return out
 
 
+def _toml_moved_key(m, k):
+    """`k` as a headerless top-level key that now sits under a header in `m`.
+
+    A top-level key a milestone removes must be removed by its TEXT even when an
+    inserted table header has re-qualified it (`k` -> `<table>.k`).
+    """
+    if "." in k or k.startswith("table:") or k in m["sym"]:
+        return None
+    for j, v in m["sym"].items():
+        if not j.endswith("." + k):
+            continue
+        body = [l for l in v["text"].splitlines() if l.strip() and not l.strip().startswith("#")]
+        if not body or _toml_is_header(body[0]):
+            continue
+        if body[0].split("=", 1)[0].strip().strip('"').strip("'") == k:
+            return j
+    return None
+
