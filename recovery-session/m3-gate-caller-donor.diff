+            running.cancel()
+            await asyncio.gather(running, return_exceptions=True)
+
+        assert runner.calls == []
+        assert gate.mark(PassSignal.issues_changed, container=team_key) is None
+        monkeypatch.setattr(gate._log, "ainfo", original)
