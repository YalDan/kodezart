+        runner = FakeAgentRunner(events=[])
+        logging = asyncio.Event()
+        original = gate._log.ainfo
+
+        async def delayed(event: str, **fields: object) -> None:
+            await original(event, **fields)
+            if event == "pass_gate_delta":
