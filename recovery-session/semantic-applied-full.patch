+from langgraph.graph import END, START, StateGraph
+
+from kodezart.types.domain.amendment import (
+    AmendmentClaim,
+    AmendmentJudgment,
+    AmendmentReport,
+    AmendmentVerdict,
+    NativeWriterOutput,
+)
