+    elif current.body not in {expected.body, replacement}:
+        reason = "the expected comment body changed"
+    if reason is not None:
+        raise StaleCommentWriteError(
+            target=target,
+            expected_comment_key=expected.comment_key,
+            reason=reason,
+        )
