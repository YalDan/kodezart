+@pytest.mark.parametrize("source", ["env", "secret"])
+@pytest.mark.parametrize("name", ["git_remote", "KODEZART_GIT_REMOTE_ARCHIVE"])
+def test_retirement_matches_only_exact_prefixed_git_names(
+    source, name, tmp_path, monkeypatch
+):
+    if source == "env":
+        monkeypatch.setenv(name, "unrelated-value")
+        config = AppConfig(_env_file=None)
+    else:
+        (tmp_path / name).write_text("unrelated-value")
+        config = AppConfig(_env_file=None, _secrets_dir=tmp_path)
+    assert config.git.remote == DEFAULTS["remote"]
