        remaining = self._transient_failures.get(name, 0)
        if remaining > 0:
            self._transient_failures[name] = remaining - 1
            raise TransientAPIError(f"fake transient failure on {name}")
        failing = self._transport_failures.get(name, 0)
        if failing > 0:
