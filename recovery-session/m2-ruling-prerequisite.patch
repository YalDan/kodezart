+    elif mode == "duplicate-field":
+        body = first.body.replace(
+            '"authoredBy": "machine"',
+            '"authoredBy": "machine", "authoredBy": "principal"',
+        )
+    elif mode == "bad-key":
+        body = first.body.replace("Which interpretation", "Changed question")
+    elif mode == "missing-occurrence":
