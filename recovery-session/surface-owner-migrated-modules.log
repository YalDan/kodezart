    async def test_a_terminal_outcome_after_an_error_frame_is_still_terminal(
        self,
    ) -> None:
        """An ErrorEvent alone is not the signal — reaching no terminal is.
    
        The ticket loop yields an ``ErrorEvent`` on a soft failure and can
