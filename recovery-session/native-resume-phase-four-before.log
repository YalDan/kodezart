            receipt = await verifier(self, **kwargs)
            if receipt.artifact.surface.kind is SurfaceKind.CRITERION_SUB_ISSUE:
                raise failure
            return receipt
        if position == "after_reset":
            monkeypatch.setattr(port, "reset_criterion_pending", reset_cut)
