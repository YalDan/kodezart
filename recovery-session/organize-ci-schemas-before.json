[{"$defs": {"BuildableAdmission": {"additionalProperties": false, "description": "No invented decision or unavailable artifact is carried by success.", "properties": {"evidence": {"minLength": 1, "pattern": "\\S", "title": "Evidence", "type": "string"}, "findings": {"default": [], "items": {"$ref": "#/$defs/SpecFinding"}, "title": "Findings", "type": "array"}, "issueId": {"minLength": 1, "pattern": "\\S", "title": "Issueid", "type": "string"}, "verdict": {"const": "buildable", "title": "Verdict", "type": "string"}}, "required": ["verdict", "issueId", "evidence"], "title": "BuildableAdmission", "type": "object"}, "DefectRole": {"description": "A defect instance or the instruction that makes writers reproduce it.", "enum": ["instance", "mandate"], "title": "DefectRole", "type": "string"}, "RefusalKind": {"description": "Whether re-authoring can repair a refusal without a human decision.", "enum": ["spec_gap", "human_decision"], "title": "RefusalKind", "type": "string"}, "RefusedAdmission": {"additionalProperties": false, "description": "A refusal names the decision and the route it requires.", "properties": {"evidence": {"minLength": 1, "pattern": "\\S", "title": "Evidence", "type": "string"}, "findings": {"default": [], "items": {"$ref": "#/$defs/SpecFinding"}, "title": "Findings", "type": "array"}, "inventedDecision": {"minLength": 1, "pattern": "\\S", "title": "Inventeddecision", "type": "string"}, "issueId": {"minLength": 1, "pattern": "\\S", "title": "Issueid", "type": "string"}, "refusalKind": {"$ref": "#/$defs/RefusalKind"}, "verdict": {"const": "not_buildable", "title": "Verdict", "type": "string"}}, "required": ["verdict", "issueId", "evidence", "inventedDecision", "refusalKind"], "title": "RefusedAdmission", "type": "object"}, "SpecFinding": {"additionalProperties": false, "description": "Evidence for a class in the selected rubric, with any mandate verbatim.", "properties": {"defectClass": {"description": "Defect class from the selected rubric.", "minLength": 1, "title": "Defectclass", "type": "string"}, "evidence": {"description": "Concrete evidence establishing the finding.", "title": "Evidence", "type": "string"}, "issueId": {"description": "Tracker key owning the source finding.", "minLength": 1, "title": "Issueid", "type": "string"}, "mandateText": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Exact instructing sentence for MANDATE, absent for INSTANCE.", "title": "Mandatetext"}, "role": {"$ref": "#/$defs/DefectRole", "description": "An instance or the instruction that mandates it."}}, "required": ["issueId", "defectClass", "evidence", "role"], "title": "SpecFinding", "type": "object"}, "UnverifiableAdmission": {"additionalProperties": false, "description": "Unavailable evidence retains its named dependency without inventing it.", "properties": {"evidence": {"minLength": 1, "pattern": "\\S", "title": "Evidence", "type": "string"}, "findings": {"default": [], "items": {"$ref": "#/$defs/SpecFinding"}, "title": "Findings", "type": "array"}, "issueId": {"minLength": 1, "pattern": "\\S", "title": "Issueid", "type": "string"}, "missingArtifact": {"minLength": 1, "pattern": "\\S", "title": "Missingartifact", "type": "string"}, "pendingBlockerId": {"minLength": 1, "pattern": "\\S", "title": "Pendingblockerid", "type": "string"}, "verdict": {"const": "unverifiable", "title": "Verdict", "type": "string"}}, "required": ["verdict", "issueId", "evidence", "missingArtifact", "pendingBlockerId"], "title": "UnverifiableAdmission", "type": "object"}}, "description": "The agent sees the same discriminated legal states its consumer validates.", "discriminator": {"mapping": {"buildable": "#/$defs/BuildableAdmission", "not_buildable": "#/$defs/RefusedAdmission", "unverifiable": "#/$defs/UnverifiableAdmission"}, "propertyName": "verdict"}, "oneOf": [{"$ref": "#/$defs/BuildableAdmission"}, {"$ref": "#/$defs/RefusedAdmission"}, {"$ref": "#/$defs/UnverifiableAdmission"}], "title": "AdmissionJudgment"}, {"$defs": {"BodyProposal": {"additionalProperties": false, "properties": {"body": {"minLength": 1, "pattern": "\\S", "title": "Body", "type": "string"}, "issueId": {"minLength": 1, "title": "Issueid", "type": "string"}, "kind": {"const": "body", "title": "Kind", "type": "string"}}, "required": ["kind", "issueId", "body"], "title": "BodyProposal", "type": "object"}, "CriteriaProposal": {"additionalProperties": false, "properties": {"criteria": {"items": {"$ref": "#/$defs/CriterionProposal"}, "minItems": 1, "title": "Criteria", "type": "array"}, "issueId": {"minLength": 1, "title": "Issueid", "type": "string"}, "kind": {"const": "criteria", "title": "Kind", "type": "string"}}, "required": ["kind", "issueId", "criteria"], "title": "CriteriaProposal", "type": "object"}, "CriterionProposal": {"additionalProperties": false, "properties": {"check": {"minLength": 1, "pattern": "\\S", "title": "Check", "type": "string"}, "do": {"minLength": 1, "pattern": "\\S", "title": "Do", "type": "string"}, "title": {"minLength": 1, "pattern": "\\S", "title": "Title", "type": "string"}}, "required": ["title", "check", "do"], "title": "CriterionProposal", "type": "object"}, "UnavailableProposal": {"additionalProperties": false, "properties": {"capability": {"enum": ["parent", "blockedBy", "relatedTo", "priority", "milestone", "split", "criterion_edit"], "title": "Capability", "type": "string"}, "evidence": {"minLength": 1, "pattern": "\\S", "title": "Evidence", "type": "string"}, "issueId": {"minLength": 1, "title": "Issueid", "type": "string"}, "kind": {"const": "unavailable", "title": "Kind", "type": "string"}}, "required": ["kind", "issueId", "capability", "evidence"], "title": "UnavailableProposal", "type": "object"}, "UnresolvedProposal": {"additionalProperties": false, "properties": {"evidence": {"minLength": 1, "pattern": "\\S", "title": "Evidence", "type": "string"}, "issueId": {"minLength": 1, "title": "Issueid", "type": "string"}, "kind": {"const": "unresolved", "title": "Kind", "type": "string"}, "question": {"minLength": 1, "pattern": "\\S", "title": "Question", "type": "string"}}, "required": ["kind", "issueId", "question", "evidence"], "title": "UnresolvedProposal", "type": "object"}}, "discriminator": {"mapping": {"body": "#/$defs/BodyProposal", "criteria": "#/$defs/CriteriaProposal", "unavailable": "#/$defs/UnavailableProposal", "unresolved": "#/$defs/UnresolvedProposal"}, "propertyName": "kind"}, "oneOf": [{"$ref": "#/$defs/BodyProposal"}, {"$ref": "#/$defs/CriteriaProposal"}, {"$ref": "#/$defs/UnresolvedProposal"}, {"$ref": "#/$defs/UnavailableProposal"}], "title": "OrganizeProposal"}, {"$defs": {"AuditVerdict": {"description": "Evidence supports, refutes, or cannot settle a claim.", "enum": ["holds", "refuted", "unverifiable"], "title": "AuditVerdict", "type": "string"}}, "additionalProperties": false, "description": "One round's judgment of the artifact that actually landed.\n\n``cited_refs`` are the references the judgment turned on \u2014 the test\npaths, files or shas the artifact named and the judgment checked.  A\nrefutation must name at least one: a repair round is driven by what\nthe previous round found wrong, and a refutation citing nothing\nleaves the writing step guessing at its own defect.", "properties": {"citedRefs": {"default": [], "items": {"minLength": 1, "pattern": "\\S", "type": "string"}, "title": "Citedrefs", "type": "array"}, "evidence": {"minLength": 1, "pattern": "\\S", "title": "Evidence", "type": "string"}, "verdict": {"$ref": "#/$defs/AuditVerdict"}}, "required": ["verdict", "evidence"], "title": "WriteBackFinding", "type": "object"}]