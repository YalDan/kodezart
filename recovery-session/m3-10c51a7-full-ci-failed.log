check	Run make check	2026-09-13T00:29:44.5452622Z             '  - test — `make test`, after build\n'
check	Run make check	2026-09-13T00:29:44.5452893Z             '  - test-integration — `make test-integration`, after build\n'
check	Run make check	2026-09-13T00:29:44.5453046Z             '- second-repo (trunk `main`):\n'
check	Run make check	2026-09-13T00:29:44.5453311Z             '  - format — `make format-check`, a gate: its failure is a root '
check	Run make check	2026-09-13T00:29:44.5453478Z             'cause\n'
check	Run make check	2026-09-13T00:29:44.5453670Z             '  - lint — `make lint`, after format\n'
check	Run make check	2026-09-13T00:29:44.5453856Z             '  - build — `make build`, after lint\n'
check	Run make check	2026-09-13T00:29:44.5454044Z             '  - test — `make test`, after build\n'
check	Run make check	2026-09-13T00:29:44.5454249Z             "Also capture each repo's default-branch history since the "
check	Run make check	2026-09-13T00:29:44.5454532Z             "mention-scan checkpoint (`git log --format='%h %ad %s' --stat`) — "
check	Run make check	2026-09-13T00:29:44.5454762Z             "this commit list is step 2's reconciliation input: every commit in it "
check	Run make check	2026-09-13T00:29:44.5454982Z             'must end the pass mapped to an issue or swept against open-issue '
