check	Run make check	2026-09-13T00:29:44.4965448Z E                   '\n'
check	Run make check	2026-09-13T00:29:44.4965797Z E                   'If that returns nothing, load by explicit name:\n'
check	Run make check	2026-09-13T00:29:44.4966171Z E                   '  ToolSearch  query: '
