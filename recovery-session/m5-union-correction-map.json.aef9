          "symbol": "work_ref",
          "start": 69,
          "end": 76,
          "source": "def work_ref(lane: str, branch: str, sha: str) -> WorkRef:\n    return WorkRef(\n        issue_id=lane,\n        role=WorkRefRole.DELIVERABLE,\n        branch=branch,\n        pushed_head_sha=sha,\n        recorded_at=datetime(2026, 1, 1, tzinfo=UTC),\n    )\n",
