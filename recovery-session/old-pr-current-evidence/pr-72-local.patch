+
+class ResolvedScope(CamelCaseModel):
+    """A resolved reference and the issues whose own fields describe its graph."""
+
+    model_config = ConfigDict(frozen=True)
+
+    ref: ScopeRef
+    issues: tuple[TrackerIssue, ...]
