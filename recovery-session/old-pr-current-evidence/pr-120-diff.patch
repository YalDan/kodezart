+        queue_state_labels=QUEUE_STATE_LABELS,
+        workflow_state_names=WORKFLOW_STATE_NAMES,
+        team_identifiers=TEAM_IDENTIFIERS,
+        retry=RetryPolicy(attempts=1, initial_delay=0),
+        clock=lambda: FIXTURE_NOW,
