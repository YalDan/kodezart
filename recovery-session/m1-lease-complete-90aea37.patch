+    async def test_a_lapsed_lease_is_not_renewable(
+        self,
+        tracker: TrackerPort,
+        clock: FixtureClock,
+    ) -> None:
+        """A lapse hands the surfaces back; renewal may not take them again."""
+        requested = frozenset({CLAIMED_DESCRIPTION, MARKER_A})
+        await tracker.acquire_surfaces(
+            surfaces=requested,
+            holder=JOB_A,
