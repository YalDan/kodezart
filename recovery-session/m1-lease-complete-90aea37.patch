+        lapsing.renew_surfaces(
+            surfaces=held, holder="job-a", lease_seconds=LEASE_SECONDS
+        )
+    )
+    await asyncio.wait_for(paused.reached.wait(), 5)
+    board.now = board.server.comments[0].created_at + timedelta(
+        seconds=LEASE_SECONDS + 1
