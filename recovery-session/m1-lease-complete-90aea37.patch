+            entry
+            for entry in markers
+            if not entry.retracted
+            and entry.in_force
+            and entry.deadline > now
+            and encoded in entry.addresses
+        ]
+        owner: str | None = None
+        if live:
+            earliest = min(live, key=lambda entry: entry.order)
+            tying = {
+                entry.holder
+                for entry in live
+                if entry.created_at == earliest.created_at
+            }
