KODEZART_PROJECT_NAME=kodezart
KODEZART_DEBUG=false
KODEZART_LOG_LEVEL=INFO
KODEZART_LOG_PRETTY=false
KODEZART_API_V1_PREFIX=/api/v1
# GitHub personal access token for repository cloning (optional)
KODEZART_GITHUB_TOKEN=
# Local directory for cached repository clones
KODEZART_CLONE_CACHE_DIR=/tmp/kodezart-clones
# Post-merge fix loop and CI monitoring
KODEZART_MAX_FIX_ROUNDS=2
KODEZART_CI_POLL_INTERVAL_SECONDS=30
KODEZART_CI_POLL_MAX_ATTEMPTS=60
KODEZART_CI_NO_CHECKS_GRACE_POLLS=10
KODEZART_FORGE_API_TIMEOUT_SECONDS=30
KODEZART_FORGE_API_BASE_URL=https://api.github.com
# Fire queue retention — two independent windows, deliberately separate:
# the terminal job record is small and kept long; its replay buffer is
# large and dropped much sooner. Buffer retention must not exceed record
# retention (rejected at boot).
KODEZART_QUEUE_TERMINAL_RETENTION_SECONDS=86400
KODEZART_QUEUE_EVENT_BUFFER_RETENTION_SECONDS=900
