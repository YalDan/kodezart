KODEZART_PROJECT_NAME=kodezart
KODEZART_DEBUG=false
KODEZART_LOG_LEVEL=INFO
KODEZART_LOG_PRETTY=false
KODEZART_API_V1_PREFIX=/api/v1
# GitHub personal access token for repository cloning (optional). The field is
# str | None and an empty assignment is NOT an unset one — it would hand the
# clone path an empty token. Leave the line commented out to keep it unset.
#KODEZART_GITHUB_TOKEN=ghp_replace_me
# Local directory for cached repository clones
KODEZART_CLONE_CACHE_DIR=/tmp/kodezart-clones
# Post-merge fix loop and CI monitoring
KODEZART_MAX_FIX_ROUNDS=2
KODEZART_CI_POLL_INTERVAL_SECONDS=30
KODEZART_CI_POLL_MAX_ATTEMPTS=60
KODEZART_CI_NO_CHECKS_GRACE_POLLS=10
KODEZART_CI_NO_WORKFLOWS_GRACE_POLLS=3
KODEZART_CI_GRACE_POLL_INTERVAL_SECONDS=10.0
KODEZART_CI_REF_NOT_FOUND_GRACE_POLLS=3
KODEZART_FORGE_API_TIMEOUT_SECONDS=30
KODEZART_FORGE_API_BASE_URL=https://api.github.com
# Prompt sets — which template serves each pipeline step. Deliberately a
# SEPARATE axis from KODEZART_MODEL: the set decides what is said, the model
# decides who says it.
KODEZART_PROMPT_SET=claude-opus
# JSON object, function key -> set name. Overrides the default set for those
# keys only; every other key still resolves through the default set.
KODEZART_PROMPT_SET_OVERRIDES={}
# JSON object, function key -> filesystem path of a template file. Highest
# precedence layer; beats both set layers for the named key.
KODEZART_PROMPT_TEMPLATE_OVERRIDES={}
# Claude model override, independent of the prompt-set axis above. The field
# is str | None and UNSET means the account default; an empty assignment is a
# different thing — it sends an empty model id to the SDK. Leave it commented
# out unless you are actually pinning a model.
#KODEZART_MODEL=claude-opus-4-5
# Skills — three-state, host-provisioned at user scope. kodezart neither
# vendors nor installs skills; it only selects among what the host provides.
#   none     suppress every skill (the shipped default)
#   all      load every discovered skill
#   explicit load exactly KODEZART_SKILLS_ALLOWLIST
# EXPLICIT with an empty allowlist, or any other mode with a non-empty one,
# is a typed configuration error. Under EXPLICIT every name is pre-flighted
# against the host inventory at boot and an unresolvable name aborts startup.
KODEZART_SKILLS_MODE=none
KODEZART_SKILLS_ALLOWLIST=[]
# Settings sources loaded for each agent session. Passed explicitly so
# enabling the skills knob never silently narrows them.
KODEZART_SETTING_SOURCES=["user","project","local"]
# Host directory holding user-scope skills and plugin bundles. A bare skill is
# named by its directory; a plugin skill is named <plugin>:<skill> and is
# discovered through the host's plugins/installed_plugins.json.
KODEZART_CLAUDE_HOME_DIR=~/.claude
# Outbound content gate. Visibility is resolved once per run; when the target
# is PUBLIC or UNKNOWN every outbound write (PR body, PR comment, commit
# message, branch name, .kodezart/ artifacts) is scanned. Pattern sets ship
# empty except the credential category, so an unconfigured deployment sees
# every payload CLEAN. The value below IS the shipped default, spelled out in
# full: assigning {} would delete the credential category and publish a
# token-bearing URL verbatim on a public target.
KODEZART_DENY_PATTERNS={"cross_repo_names":[],"tracker_urls":[],"email_handles":[],"infra_endpoints":[],"credentials":["https?://x-access-token:[^@\\s/]+@","\\bgh[posu]_[A-Za-z0-9]{36,}","\\bgithub_pat_[A-Za-z0-9_]{20,}"]}
# Category -> verdict. A payload takes the MAX severity over its hits
# (blocked > redacted > clean). Identifier writers block on any hit. Again the
# shipped default in full — {} would leave every category without a verdict.
KODEZART_DENY_PATTERN_VERDICTS={"cross_repo_names":"redacted","tracker_urls":"redacted","email_handles":"redacted","infra_endpoints":"blocked","credentials":"blocked"}
# Operation config — the org-shaped runtime configuration, TOML, parsed with
# stdlib tomllib. See docs/operation.example.toml. Secrets NEVER go in that
# file; they stay here in the environment. The field is str | None: UNSET
# means no operation config is loaded, whereas an empty assignment is a path
# of "" and startup fails with "operation config not found". Leave the line
# commented out unless you are pointing at a real file.
#KODEZART_OPERATION_CONFIG=docs/operation.example.toml
# Fire queue retention — two independent windows, deliberately separate:
# the terminal job record is small and kept long; its replay buffer is
# large and dropped much sooner. Buffer retention must not exceed record
# retention (rejected at boot).
KODEZART_QUEUE_TERMINAL_RETENTION_SECONDS=86400
KODEZART_QUEUE_EVENT_BUFFER_RETENTION_SECONDS=900
KODEZART_QUEUE_EVENT_BUFFER_CAPACITY=512
KODEZART_QUEUE_MAX_CONCURRENT_RUNS_PER_LANE=1
KODEZART_QUEUE_MAX_DEPTH_PER_LANE=64
# Tracker — which adapter implements TrackerPort, and the vendor MCP server it
# dials. Adding a backend is a new adapter plus a TrackerBackend member, never
# a consumer change. The token is a credential and lives ONLY here.
KODEZART_TRACKER=linear
KODEZART_TRACKER_MCP_SERVER_NAME=linear
KODEZART_TRACKER_MCP_SERVER_URL=https://mcp.linear.app/mcp
#KODEZART_TRACKER_TOKEN=lin_api_replace_me
KODEZART_TRACKER_API_TIMEOUT_SECONDS=30
KODEZART_TRACKER_API_MAX_RETRIES=3
KODEZART_TRACKER_API_RETRY_BACKOFF_FACTOR=1.0
KODEZART_TRACKER_QUERY_PAGE_SIZE=50
# Lease an atomic claim holds before the issue becomes eligible again. Long
# enough that a live run never loses its own issue; short enough that a run
# killed mid-flight frees it without an operator.
KODEZART_TRACKER_CLAIM_LEASE_SECONDS=900
# Approved-fire dispatch — the pass interval and the queue lane dispatches
# land on. Cadence is configuration, never a literal in a pass.
KODEZART_DISPATCH_PASS_INTERVAL_SECONDS=300
KODEZART_DISPATCH_LANE=tracker
