KODEZART_PROJECT_NAME=kodezart
KODEZART_DEBUG=false
KODEZART_LOG_LEVEL=INFO
KODEZART_LOG_PRETTY=false
KODEZART_API_V1_PREFIX=/api/v1
# GitHub personal access token for repository cloning (optional). The field is
# str | None and an empty assignment is NOT an unset one — it is refused at
# startup. Leave the line commented out to keep it unset.
#KODEZART_GITHUB_TOKEN=ghp_replace_me
# Local directory for cached repository clones
KODEZART_CLONE_CACHE_DIR=/tmp/kodezart-clones
KODEZART_INTEGRATION_WORKSPACE_DIR=/tmp/kodezart-integration
# Post-merge fix loop and CI monitoring
KODEZART_REMEDIATION_MAX_ROUNDS=1
KODEZART_CI_POLL_INTERVAL_SECONDS=30
KODEZART_CI_POLL_MAX_ATTEMPTS=60
KODEZART_CI_NO_CHECKS_GRACE_POLLS=10
KODEZART_CI_NO_WORKFLOWS_GRACE_POLLS=3
KODEZART_CI_GRACE_POLL_INTERVAL_SECONDS=10.0
KODEZART_CI_REF_NOT_FOUND_GRACE_POLLS=3
KODEZART_CI_CHECK_RUNS_MAX_PAGES=10
KODEZART_FORGE_API_TIMEOUT_SECONDS=30
KODEZART_FORGE_API_BASE_URL=https://api.github.com
# Ticket loop shape: `create_only` (the shipped default) compiles no review
# arm and the creator's draft is checked by the set's draft-critic lens,
# dispatched as its own session; `reviewed` runs a harness-level reviewer
# session and revises against its verdict. Setting KODEZART_MAX_REVIEWS under
# create_only is refused at boot rather than ignored, and so is create_only
# over a set declaring no draft-critic lens.
KODEZART_TICKET_REVIEW_MODE=create_only
# Read-only investigator sessions one generative dispatch may fan out to.
# Substituted into the prompt set's investigation spec when the set resolves.
KODEZART_INVESTIGATION_CAP=5
# Prompt sets — which template serves each pipeline step. Deliberately a
# SEPARATE axis from KODEZART_MODEL: the set decides what is said, the model
# decides who says it. `claude-opus` is the legacy set, kept complete and
# byte-frozen; ROLLING BACK TO IT TAKES BOTH LINES, because the legacy set
# declares no draft-critic lens and the mode above requires one:
#   KODEZART_PROMPT_SET=claude-opus
#   KODEZART_TICKET_REVIEW_MODE=reviewed
KODEZART_PROMPT_SET=anthropic_v5
# JSON object, function key -> set name. Overrides the default set for those
# keys only; every other key still resolves through the default set.
KODEZART_PROMPT_SET_OVERRIDES={}
# JSON object, function key -> filesystem path of a template file. Highest
# precedence layer; beats both set layers for the named key.
KODEZART_PROMPT_TEMPLATE_OVERRIDES={}
# Claude model override, independent of the prompt-set axis above. The field
# is str | None and UNSET means the account default; an empty assignment is a
# different thing — it sends an empty model id to the SDK. Leave it commented
# out unless you are actually pinning a model.
#KODEZART_MODEL=claude-opus-4-5
# JSON object, function key -> engine, overriding the model above for those
# keys' sessions only (KOD-161). Deployment-shaped: the prompt set declares
# intended engines, this table decides. A key outside the prompt-key
# vocabulary is refused at boot. Empty means every key resolves as before.
#KODEZART_SESSION_MODELS={"implementation": "claude-opus-4-5"}
# Claude Code output style every engine session runs under. The field is
# str | None and UNSET means no style is sent at all, so the CLI's own default
# stands — nothing here is picked in code. The session's init message is read
# back and a declared style it does not confirm fails that session. The style
# must exist in the bundled CLI: Concise needs 2.1.237 or newer.
#KODEZART_CLAUDE_OUTPUT_STYLE=Concise
# Skills — three-state, host-provisioned at user scope. kodezart neither
# vendors nor installs skills; it only selects among what the host provides.
#   none     suppress every skill (the shipped default)
#   all      load every discovered skill
#   explicit load exactly KODEZART_SKILLS_ALLOWLIST
# EXPLICIT with an empty allowlist, or any other mode with a non-empty one,
# is a typed configuration error. Under EXPLICIT every name is pre-flighted
# against the host inventory at boot and an unresolvable name aborts startup.
KODEZART_SKILLS_MODE=none
KODEZART_SKILLS_ALLOWLIST=[]
# Settings sources loaded for each agent session. Passed explicitly so
# enabling the skills knob never silently narrows them.
KODEZART_SETTING_SOURCES=["user","project","local"]
# Host directory holding user-scope skills and plugin bundles. A bare skill is
# named by its directory; a plugin skill is named <plugin>:<skill> and is
# discovered through the host's plugins/installed_plugins.json.
KODEZART_CLAUDE_HOME_DIR=~/.claude
# Outbound content gate. Visibility is resolved once per run; when the target
# is PUBLIC or UNKNOWN every outbound write (PR body, PR comment, commit
# message, branch name, .kodezart/ artifacts) is scanned. Pattern sets ship
# empty except the credential category, so an unconfigured deployment sees
# every payload CLEAN. The value below IS the shipped default, spelled out in
# full: assigning {} would delete the credential category and publish a
# token-bearing URL verbatim on a public target.
KODEZART_DENY_PATTERNS={"cross_repo_names":[],"tracker_urls":[],"email_handles":[],"infra_endpoints":[],"credentials":["(https?://x-access-token:)[^@\\s/]+(@)","\\bgh[posu]_[A-Za-z0-9]{36,}","\\bgithub_pat_[A-Za-z0-9_]{20,}","\\b(?:ntn_|secret_)[A-Za-z0-9]{40,}","\\blin_(?:api|oauth)_[A-Za-z0-9]{40,}","\\bsk-ant-[A-Za-z0-9_-]{20,}"]}
# Category -> verdict. A payload takes the MAX severity over its hits
# (blocked > redacted > clean). Identifier writers block on any hit. Again the
# shipped default in full — {} would leave every category without a verdict.
KODEZART_DENY_PATTERN_VERDICTS={"cross_repo_names":"redacted","tracker_urls":"redacted","email_handles":"redacted","infra_endpoints":"blocked","credentials":"blocked","org_private":"redacted"}
# The judgment half of the gate, ordered AFTER the patterns. Ships disabled:
# the mechanism ships and the policy is operator configuration. Enabling it
# without an OperationConfig private_surface description aborts startup rather
# than registering a scanner that would block every authored write. org_private
# is rejected as a KODEZART_DENY_PATTERNS key by construction — a pattern
# naming an organisation contains the string it protects.
KODEZART_AGENTIC_CONTENT_SCANNER_ENABLED=false
# Bounded retry and wall-clock bound for one audit session. Exhaustion is a
# named failure kind and every failure kind BLOCKS; none degrades to clean.
KODEZART_CONTENT_SCAN_RETRY_MAX_ATTEMPTS=2
KODEZART_CONTENT_SCAN_RETRY_INITIAL_INTERVAL=1.0
KODEZART_CONTENT_SCAN_TIMEOUT_SECONDS=120.0
# The audit session's working directory. Deliberately NOT the cloned target
# repository: an auditor whose working directory is attacker-writable is not
# an auditor.
KODEZART_CONTENT_AUDIT_WORKING_DIR=/tmp/kodezart-content-audit
# Operation config — the org-shaped runtime configuration, TOML, parsed with
# stdlib tomllib. See docs/operation.example.toml. Secrets NEVER go in that
# file; they stay here in the environment. The field is str | None: UNSET
# means no operation config is loaded, whereas an empty assignment is a path
# of "" and startup fails with "operation config not found". Leave the line
# commented out unless you are pointing at a real file.
#KODEZART_OPERATION_CONFIG=docs/operation.example.toml
# Fire queue retention — two independent windows, deliberately separate:
# the terminal job record is small and kept long; its replay buffer is
# large and dropped much sooner. Buffer retention must not exceed record
# retention (rejected at boot).
KODEZART_QUEUE_TERMINAL_RETENTION_SECONDS=86400
KODEZART_QUEUE_EVENT_BUFFER_RETENTION_SECONDS=900
KODEZART_QUEUE_EVENT_BUFFER_CAPACITY=512
KODEZART_QUEUE_MAX_CONCURRENT_RUNS_PER_LANE=1
KODEZART_QUEUE_MAX_DEPTH_PER_LANE=64
# Tracker — which adapter implements TrackerPort, and the vendor MCP server it
# dials. Adding a backend is a new adapter plus a TrackerBackend member, never
# a consumer change. The token is a credential and lives ONLY here.
KODEZART_TRACKER=linear
KODEZART_TRACKER_MCP_SERVER_NAME=linear
KODEZART_TRACKER_MCP_SERVER_URL=https://mcp.linear.app/mcp
#KODEZART_TRACKER_TOKEN=lin_api_replace_me
KODEZART_TRACKER_TIMEOUT_SECONDS=30
KODEZART_TRACKER_MCP_SSE_READ_TIMEOUT_SECONDS=300
KODEZART_TRACKER_MAX_RETRIES=3
KODEZART_TRACKER_RETRY_BACKOFF_FACTOR=1.0
KODEZART_TRACKER_QUERY_PAGE_SIZE=50
# Lease an atomic claim holds before the issue becomes eligible again, and
# the fraction of it at which a job still in flight renews. The lease is
# short so a run killed mid-flight frees its issue without an operator; the
# renewal is what stops a run that OUTLIVES the lease from losing an issue
# it is still working. Measured fires run several times the lease.
KODEZART_TRACKER_CLAIM_LEASE_SECONDS=900
KODEZART_TRACKER_CLAIM_RENEWAL_FRACTION=0.25
# Approved-fire dispatch — the pass interval and the queue lane dispatches
# land on. Cadence is configuration, never a literal in a pass.
KODEZART_DISPATCH_PASS_INTERVAL_SECONDS=300
KODEZART_DISPATCH_LANE=tracker
# Assets a fire's ticket references. Every reference is required: a fetch
# that failed and a fetch that was skipped are indistinguishable to the
# session working the fire, so there is no skip — the fire does not build.
KODEZART_TRACKER_ASSET_MAX_COUNT=20
KODEZART_TRACKER_ASSET_MAX_BYTES=10485760
KODEZART_TRACKER_ASSET_FETCH_TIMEOUT_SECONDS=30
# Private knowledge base — the knowledge MCP credential. Environment only: it
# is never written to the file-based operation config, whose extra="forbid"
# makes a secret key there a boot error. Excluded from serialization, so it
# appears in no dumped config, and is redacted at error egress if it ever
# reaches stderr. The server knobs below are role-named; the vendor is a value.
#KODEZART_KNOWLEDGE_MCP_TOKEN=ntn_replace_me
# Which kinds of agent session are configured with the knowledge server. No
# wildcard: granting everything means naming everything. Ships empty — the
# mechanism ships and the grant is operator configuration. The intended first
# grant is ["ticket_fire"], which also requires the credential above; a
# non-empty grant with the credential unset aborts boot, and an entry naming
# no known session type aborts boot listing what is legal.
KODEZART_KNOWLEDGE_SESSION_GRANTS=[]
KODEZART_KNOWLEDGE_MCP_SERVER_NAME=notion
# No endpoint ships: a granted http deployment names its own self-hosted
# server here, and a granted http route with none aborts boot naming it.
#KODEZART_KNOWLEDGE_MCP_SERVER_URL=https://knowledge.example.com/mcp
KODEZART_KNOWLEDGE_MCP_SSE_READ_TIMEOUT_SECONDS=300
KODEZART_KNOWLEDGE_MCP_AUTH_HEADER=Authorization
# The literal value null means no scheme: the credential rides raw in its
# header.
KODEZART_KNOWLEDGE_MCP_AUTH_SCHEME=Bearer
# The route a granted session takes: http dials the endpoint above with
# headers; stdio spawns a self-hosted server binary. Each route reads its own
# fields and only its own — a field the declared route never reads aborts
# boot naming it. NOTE: a host that authenticates interactively (OAuth) takes
# no static credential at all; a static-credential deployment points the url
# at a self-hosted server or uses stdio.
KODEZART_KNOWLEDGE_MCP_TRANSPORT=http
# Gateway credential for a SELF-HOSTED http knowledge server (presented as
# Authorization: Bearer ...). Environment only, never serialized. With the
# upstream token set as well, the auth header above must name the server's
# pass-through header — the gateway credential owns Authorization.
#KODEZART_KNOWLEDGE_MCP_GATEWAY_TOKEN=replace_me
# The stdio route: an ABSOLUTE path to the installed server binary (package
# runners are refused — they resolve or fetch their payload at spawn time),
# its arguments, its non-secret environment, and the name of the environment
# entry the server reads its credential from. The credential value itself
# comes from KODEZART_KNOWLEDGE_MCP_TOKEN.
#KODEZART_KNOWLEDGE_MCP_COMMAND=/usr/local/bin/knowledge-mcp-server
#KODEZART_KNOWLEDGE_MCP_ARGS=[]
#KODEZART_KNOWLEDGE_MCP_TIMEOUT_SECONDS=30.0
#KODEZART_KNOWLEDGE_MCP_ERROR_DETAIL_LIMIT=500
#KODEZART_KNOWLEDGE_MCP_ENV={}
#KODEZART_KNOWLEDGE_MCP_CREDENTIAL_ENV=NOTION_TOKEN
# Hosts that only authenticate interactively; a granted endpoint on one of
# them paired with a static credential aborts boot, naming the conflict.
KODEZART_KNOWLEDGE_MCP_INTERACTIVE_AUTH_HOSTS=["mcp.notion.com"]
